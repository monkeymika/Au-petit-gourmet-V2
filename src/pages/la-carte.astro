---
import BaseLayout from "@layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { restaurant } from "@data/restaurant";
import { menu, menuFooter, formatPrice } from "@data/menu";
import { menus, allergensList } from "@data/menus";
import { boissons, boissonsFooter } from "@data/boissons";
import { vins, formatWinePrice } from "@data/vins";
import Hero from "@components/Hero.astro";
import BookingCTA from "@components/BookingCTA.astro";
import heroLaCarte from "@/assets/page-lacarte/hero-lacarte.webp";

const tabs = [
  { id: "carte", label: "La carte" },
  { id: "menus", label: "Menus & Formules" },
  { id: "boissons", label: "Boissons" },
  { id: "vins", label: "Vins" },
];

const accentClasses: Record<"forest" | "terracotta" | "magenta", { text: string }> = {
  forest: { text: "text-forest-700" },
  terracotta: { text: "text-terracotta-600" },
  magenta: { text: "text-[#C8127F]" },
};
---

<BaseLayout
  title="AuPetitGourmet - La carte | Découvrez le menu du restaurant Au petit gourmet"
  description="Découvrez la carte du restaurant Au Petit Gourmet à Ville-en-Vermois : entrées, plats, fromages, desserts, menus, boissons et carte des vins. Cuisine locale, produits frais et de saison."
>
  <Hero imageSrc={heroLaCarte} imageAlt="Table dressée au restaurant Au Petit Gourmet — cuisine locale et de saison">
    <Fragment slot="eyebrow">À la carte · Au Petit Gourmet</Fragment>
    <Fragment slot="title">
      Une invitation<br />au <em class="text-terracotta-500">terroir.</em>
    </Fragment>
    <Fragment slot="description">
      <p>Savourez une cuisine locale et de saison, préparée avec des produits frais et du terroir, pour ravir toutes les papilles.</p>
    </Fragment>
  </Hero>

  <!-- Onglets sticky — vraie pill autonome centrée, sans bordures pleine largeur -->
  <div id="carte-tabs" class="sticky top-24 z-30 -mt-4 flex justify-center px-4">
    <nav
      class="flex flex-wrap justify-center gap-1 rounded-3xl border border-ink-900/10 bg-cream-50/90 px-2 py-1.5 shadow-[0_8px_24px_-12px_rgba(42,33,28,0.18)] backdrop-blur-md sm:gap-2 md:rounded-full md:px-3 md:py-2"
      aria-label="Sections de la carte"
    >
      {tabs.map((tab) => (
        <button
          type="button"
          data-tab-target={tab.id}
          class="tab-btn rounded-full px-3 py-1.5 font-serif text-xs text-ink-500 transition-all hover:text-forest-900 data-[active=true]:bg-forest-700 data-[active=true]:text-cream-50 sm:px-4 sm:py-2 sm:text-sm md:px-5 md:text-base"
        >
          {tab.label}
        </button>
      ))}
    </nav>
  </div>

  <!-- Onglet 1 : La carte -->
  <section id="carte" data-tab="carte" class="tab-panel relative">
    <div class="container-content pt-12 md:pt-16">
      <nav class="flex flex-wrap justify-center gap-3" aria-label="Sommaire de la carte">
        {menu.sections.map((section) => (
          <a
            href={`#${section.slug}`}
            class="rounded-full border border-ink-900/15 px-5 py-2 text-sm font-medium text-ink-900 transition-all hover:border-forest-700 hover:bg-forest-700 hover:text-cream-50"
          >
            {section.title}
          </a>
        ))}
      </nav>
    </div>

    {menu.sections.map((section) => (
      <section id={section.slug} class="container-content scroll-mt-40 py-16 md:py-20">
        <div class="mb-12 flex items-center gap-6 md:mb-16">
          <h3 class="font-serif text-2xl uppercase tracking-[0.22em] text-forest-900 md:text-3xl">
            {section.title}
          </h3>
          <span class="h-px flex-1 bg-ink-900/20" />
        </div>

        <ul class="space-y-10 md:space-y-14">
          {section.items.map((item) => (
            <li>
              <div class="flex items-baseline gap-4">
                <h4 class="font-serif text-xl text-forest-900 md:text-2xl">{item.name}</h4>
                <span aria-hidden="true" class="-translate-y-1 flex-1 border-b border-dotted border-ink-900/35" />
                {item.prices.length === 1 ? (
                  <span class="shrink-0 font-serif text-xl text-terracotta-500 md:text-2xl">
                    {formatPrice(item.prices[0].amount)}
                  </span>
                ) : (
                  <span class="shrink-0 font-serif text-xl text-terracotta-500 md:text-2xl">
                    {item.prices.map((p, i) => (
                      <>
                        {i > 0 && <span class="mx-2 text-ink-400">·</span>}
                        <span class="mr-1.5 text-xs font-medium uppercase tracking-[0.18em] text-ink-500">
                          {p.variant}
                        </span>
                        {formatPrice(p.amount)}
                      </>
                    ))}
                  </span>
                )}
              </div>
              {item.description && <p class="mt-2 text-base italic text-ink-700">{item.description}</p>}
              {item.allergens && (
                <p class="mt-3 text-xs font-medium uppercase tracking-[0.18em] text-ink-500">
                  Allergènes&nbsp;: {item.allergens}
                </p>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))}

    <div class="container-content pb-12 pt-4">
      <div class="border-t border-ink-900/10 pt-8 text-center">
        <p class="text-sm text-ink-500">{menuFooter.pricingNote}</p>
      </div>
    </div>
  </section>

  <!-- Onglet 2 : Menus & formules -->
  <section id="menus" data-tab="menus" class="tab-panel hidden">
    <div class="container-content space-y-12 pt-16 pb-16 md:space-y-16 md:pt-20 md:pb-20">
      {menus.map((m) => (
        <article class="relative overflow-hidden rounded-3xl border border-ink-900/10 bg-cream-100/40 p-8 md:p-12">
          <div class="grid gap-8 md:grid-cols-12 md:gap-12">
            <header class="md:col-span-4">
              {m.subtitle && <p class="eyebrow">{m.subtitle}</p>}
              <h3 class="mt-3 font-serif text-3xl text-forest-900 md:text-4xl">{m.title}</h3>
              <p class="mt-4 font-serif text-3xl text-terracotta-500 md:text-4xl">
                {formatWinePrice(m.price)}
              </p>
              {m.schedule && (
                <p class="mt-4 text-xs font-medium uppercase tracking-[0.18em] text-ink-500">
                  {m.schedule}
                </p>
              )}
            </header>
            <div class="md:col-span-8">
              <ul class="space-y-6">
                {m.courses?.map((c) => (
                  <li class="border-l-2 border-forest-700/40 pl-5">
                    <p class="font-serif text-lg text-forest-900">{c.label}</p>
                    {c.items && c.items.length > 0 && (
                      <ul class="mt-2 space-y-1.5 text-base italic text-ink-700">
                        {c.items.map((line) => <li>· {line}</li>)}
                      </ul>
                    )}
                    {c.allergens && (
                      <p class="mt-2 text-[11px] font-medium uppercase tracking-[0.18em] text-ink-500">
                        Allergènes&nbsp;: {c.allergens}
                      </p>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="container-content pb-12">
      <div class="border-t border-ink-900/10 pt-8 text-center">
        <p class="text-sm text-ink-500">{menuFooter.pricingNote}</p>
      </div>
    </div>
  </section>

  <!-- Onglet 3 : Boissons -->
  <section id="boissons" data-tab="boissons" class="tab-panel hidden">
    <div class="container-content pt-12 md:pt-16">
      <nav class="flex flex-wrap justify-center gap-3" aria-label="Sommaire des boissons">
        {boissons.sections.map((s) => (
          <a
            href={`#${s.slug}`}
            class="rounded-full border border-ink-900/15 px-4 py-1.5 text-xs font-medium uppercase tracking-[0.16em] text-ink-900 transition-all hover:border-forest-700 hover:bg-forest-700 hover:text-cream-50"
          >
            {s.title}
          </a>
        ))}
      </nav>
    </div>

    {boissons.sections.map((s) => (
      <section id={s.slug} class="container-content scroll-mt-40 py-14 md:py-16">
        <header class="mb-10 flex flex-col items-start gap-2 md:flex-row md:items-end md:justify-between md:gap-6">
          <div>
            <h3 class="font-serif text-2xl uppercase tracking-[0.22em] text-forest-900 md:text-3xl">
              {s.title}
            </h3>
            {s.subtitle && <p class="mt-2 text-sm italic text-ink-500">{s.subtitle}</p>}
          </div>
          <span class="h-px flex-1 bg-ink-900/15 md:mb-3" />
        </header>

        <ul class="space-y-5">
          {s.items.map((d) => (
            <li class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
              <div class="flex-1 min-w-[55%]">
                <span class="font-serif text-lg text-forest-900">
                  {d.name}
                  {d.volume && <span class="ml-2 text-xs font-medium uppercase tracking-[0.14em] text-ink-500">{d.volume}</span>}
                </span>
                {d.description && (
                  <p class="mt-1 text-sm italic text-ink-700">{d.description}</p>
                )}
              </div>
              <span aria-hidden="true" class="hidden md:block -translate-y-1 flex-1 border-b border-dotted border-ink-900/25" />
              <span class="shrink-0 font-serif text-lg text-terracotta-500">
                {d.prices.length === 1
                  ? formatWinePrice(d.prices[0].amount)
                  : d.prices.map((p, i) => (
                      <>
                        {i > 0 && <span class="mx-2 text-ink-400">·</span>}
                        <span class="mr-1.5 text-[10px] font-medium uppercase tracking-[0.18em] text-ink-500">
                          {p.variant}
                        </span>
                        {formatWinePrice(p.amount)}
                      </>
                    ))}
              </span>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <div class="container-content pb-12">
      <div class="border-t border-ink-900/10 pt-8 text-center">
        <p class="mx-auto max-w-prose text-sm text-ink-500">{boissonsFooter}</p>
      </div>
    </div>
  </section>

  <!-- Onglet 4 : Vins -->
  <section id="vins" data-tab="vins" class="tab-panel hidden">
    <div class="container-content pt-12 md:pt-16">
      <nav class="flex flex-wrap justify-center gap-3" aria-label="Sommaire de la carte des vins">
        {vins.map((cat) => (
          <a
            href={`#vins-${cat.slug}`}
            class:list={[
              "vins-nav-pill rounded-full border border-ink-900/15 px-5 py-1.5 text-xs font-medium uppercase tracking-[0.16em] transition-all hover:bg-forest-700 hover:text-cream-50 hover:border-forest-700",
              accentClasses[cat.accent].text,
            ]}
          >
            {cat.title}
          </a>
        ))}
      </nav>
    </div>

    <div class="container-content py-12 md:py-16">
      <div>
        {vins.map((cat) => {
          const accent = accentClasses[cat.accent];
          return (
            <section
              id={`vins-${cat.slug}`}
              class="scroll-mt-40 pb-20 pt-8 md:pb-24 md:pt-10"
            >
              <header class="mb-10 md:mb-14">
                <h3 class:list={["font-serif text-3xl md:text-4xl transition-colors", accent.text]}>
                  {cat.title}
                </h3>
              </header>

              <div class="space-y-14">
                {cat.regions.map((region) => (
                  <div>
                    <div class="mb-6 flex items-center gap-4">
                      <h4 class:list={["font-serif text-xl md:text-2xl", accent.text]}>
                        {region.title}
                      </h4>
                      <span class="h-px flex-1 bg-ink-900/15" />
                    </div>

                    <div class="hidden md:grid grid-cols-12 gap-2 px-1 pb-2 text-[10px] font-medium uppercase tracking-[0.18em] text-ink-500">
                      <span class="col-span-9">&nbsp;</span>
                      <span class="col-span-1 text-right">Verre</span>
                      <span class="col-span-2 text-right">{cat.bottleLabel ?? "Bouteille"}</span>
                    </div>

                    <ul class="divide-y divide-ink-900/10">
                      {region.wines.map((wine) => (
                        <li class="grid grid-cols-12 items-start gap-2 py-4 md:py-5">
                          <div class="col-span-12 md:col-span-9">
                            <p class="font-serif text-base text-forest-900 md:text-lg">{wine.name}</p>
                            <p class="mt-0.5 text-sm text-ink-700">
                              {wine.domain}
                              {wine.appellation && <> — {wine.appellation}</>}
                              {wine.year && <> · {wine.year}</>}
                            </p>
                            {wine.cepage && (
                              <p class="mt-0.5 text-xs italic text-ink-500">_ Cépage : {wine.cepage} _</p>
                            )}
                            {wine.description && (
                              <p class="mt-2 max-w-prose text-sm italic text-ink-700">{wine.description}</p>
                            )}
                          </div>
                          <span class:list={["col-span-6 mt-2 text-left font-serif text-base md:col-span-1 md:mt-0 md:text-right", accent.text]}>
                            <span class="mr-1.5 text-[10px] font-medium uppercase tracking-[0.14em] text-ink-500 md:hidden">Verre</span>
                            {wine.prices.glass ? formatWinePrice(wine.prices.glass) : <span class="text-ink-400">—</span>}
                          </span>
                          <span class:list={["col-span-6 mt-2 text-right font-serif text-base md:col-span-2 md:mt-0", accent.text]}>
                            <span class="mr-1.5 text-[10px] font-medium uppercase tracking-[0.14em] text-ink-500 md:hidden">Bout.</span>
                            {formatWinePrice(wine.prices.bottle)}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </section>
          );
        })}
      </div>
    </div>

    <div class="container-content pb-12">
      <div class="border-t border-ink-900/10 pt-8 text-center">
        <p class="mx-auto max-w-prose text-sm text-ink-500">{boissonsFooter}</p>
      </div>
    </div>
  </section>

  <!-- À emporter -->
  <section data-paw class="container-content py-16 md:py-20">
    <div class="emporter-card mx-auto max-w-2xl rounded-3xl border border-terracotta-500/25 bg-cream-100/40 px-8 py-12 text-center md:px-16 md:py-16">
      <p class="eyebrow text-terracotta-500">Fait maison</p>
      <h2 class="mt-4 font-serif text-h2 text-forest-900">À <em class="text-terracotta-500">emporter</em>.</h2>
      <p class="mx-auto mt-6 max-w-prose text-lead text-ink-700">
        <strong class="font-medium text-forest-900">Foie gras fait maison</strong>, infusé au whisky de Rozelieures — <strong class="font-medium text-terracotta-500">28&nbsp;€</strong> pour 250&nbsp;grammes.
      </p>
      <a
        href={`tel:${restaurant.phone}`}
        class="emporter-cta mt-8 inline-flex items-center gap-2 rounded-full bg-forest-700 px-7 py-3 text-sm font-medium uppercase tracking-[0.15em] text-cream-50 transition-colors hover:bg-forest-600"
      >
        N'attendez plus&nbsp;!
      </a>
    </div>
  </section>

  <!-- Allergènes (commun) -->
  <section class="surface-cream-100">
    <div class="container-content py-16 md:py-20">
      <p class="eyebrow text-center">Information</p>
      <h2 class="mt-3 text-center font-serif text-h2 text-forest-900">Liste des 14 allergènes</h2>
      <ul class="mx-auto mt-10 grid max-w-4xl gap-3 text-sm text-ink-700 md:grid-cols-2">
        {allergensList.map((a) => (
          <li class="flex gap-3">
            <span class="font-mono text-xs font-medium text-terracotta-500 mt-0.5">*{a.code}</span>
            <span>{a.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <BookingCTA />
</BaseLayout>

<style>
  .emporter-card {
    animation: emporter-glow 3s ease-in-out infinite;
  }
  .emporter-cta {
    animation: emporter-pulse 2.5s ease-in-out infinite;
  }
  @keyframes emporter-glow {
    0%, 100% { box-shadow: 0 0 0 0 rgba(176, 116, 57, 0); }
    50% { box-shadow: 0 0 40px -10px rgba(176, 116, 57, 0.15); }
  }
  @keyframes emporter-pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.04); }
  }
  @media (prefers-reduced-motion: reduce) {
    .emporter-card,
    .emporter-cta { animation: none; }
  }

  .vins-nav-pill {
    transition: color 500ms, background-color 300ms, border-color 300ms;
  }
</style>

<script>
  // Onglets de la carte — affichage exclusif, état persistant via hash URL.
  const tabButtons = document.querySelectorAll<HTMLButtonElement>(".tab-btn");
  const panels = document.querySelectorAll<HTMLElement>(".tab-panel");

  function activateTab(id: string, scroll = true) {
    let matched = false;
    tabButtons.forEach((btn) => {
      const isActive = btn.dataset.tabTarget === id;
      btn.dataset.active = isActive ? "true" : "false";
      if (isActive) matched = true;
    });
    panels.forEach((panel) => {
      const isActive = panel.dataset.tab === id;
      panel.classList.toggle("hidden", !isActive);
    });
    if (!matched) {
      activateTab("carte", false);
      return;
    }
    const activeBtn = document.querySelector<HTMLElement>('.tab-btn[data-active="true"]');
    if (activeBtn) {
      activeBtn.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
    }
    if (scroll) {
      requestAnimationFrame(() => {
        const panel = document.getElementById(id);
        if (panel) {
          const top = panel.getBoundingClientRect().top + window.scrollY;
          window.scrollTo({ top: top - 160, behavior: "smooth" });
        }
      });
    }
  }

  tabButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.dataset.tabTarget!;
      activateTab(id);
      history.replaceState(null, "", `#${id}`);
    });
  });

  // Au chargement, ouvrir l'onglet correspondant au hash si présent, sinon "carte".
  const hash = window.location.hash.replace("#", "");
  const validTabs = ["carte", "menus", "boissons", "vins"];
  if (hash && validTabs.includes(hash)) {
    activateTab(hash, false);
  } else if (hash) {
    // Si le hash correspond à une ancre interne (ex: #blancs-rhone), trouve l'onglet parent
    const target = document.getElementById(hash);
    const parentPanel = target?.closest<HTMLElement>(".tab-panel");
    if (parentPanel?.dataset.tab) {
      activateTab(parentPanel.dataset.tab, false);
      requestAnimationFrame(() => target!.scrollIntoView({ behavior: "smooth" }));
    } else {
      activateTab("carte", false);
    }
  } else {
    activateTab("carte", false);
  }

  // Intercepter les clics sur les liens internes #foo pour activer le bon onglet
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
    link.addEventListener("click", (e) => {
      const id = link.getAttribute("href")!.replace("#", "");
      if (!id) return;
      if (validTabs.includes(id)) {
        e.preventDefault();
        activateTab(id);
        history.replaceState(null, "", `#${id}`);
        return;
      }
      const target = document.getElementById(id);
      const parentPanel = target?.closest<HTMLElement>(".tab-panel");
      if (parentPanel?.dataset.tab && parentPanel.classList.contains("hidden")) {
        e.preventDefault();
        activateTab(parentPanel.dataset.tab, false);
        history.replaceState(null, "", `#${id}`);
        requestAnimationFrame(() => target!.scrollIntoView({ behavior: "smooth" }));
      }
    });
  });
</script>
