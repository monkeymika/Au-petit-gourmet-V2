---
/**
 * BackToTop — flèche flottante en bas à droite, présente sur tout le site.
 * Apparaît après ~400px de scroll, remonte la page en douceur au clic.
 * z-[50] : sous l'overlay (z-60) et la pill nav (z-70).
 */
---

<button
  id="back-to-top"
  type="button"
  aria-label="Revenir en haut de la page"
  class="pointer-events-none fixed bottom-6 right-6 z-[50] flex h-12 w-12 translate-y-3 items-center justify-center rounded-full bg-forest-700 text-cream-50 opacity-0 shadow-lg shadow-forest-900/30 transition-all duration-300 hover:bg-forest-600 md:bottom-8 md:right-8 md:h-14 md:w-14"
>
  <svg
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <line x1="12" y1="19" x2="12" y2="5" />
    <polyline points="5 12 12 5 19 12" />
  </svg>
</button>

<style>
  #back-to-top.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    #back-to-top {
      transition: none;
    }
  }
  /* Masquée sous 400px de large pour ne pas chevaucher la pill nav du bas */
  @media (max-width: 400px) {
    #back-to-top {
      display: none;
    }
  }
</style>

<script>
  const btn = document.getElementById("back-to-top");
  if (btn) {
    let ticking = false;
    const update = () => {
      btn.classList.toggle("is-visible", window.scrollY > 400);
      ticking = false;
    };
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true }
    );
    btn.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
    update();
  }
</script>
