---
/**
 * Botanical — motifs « terroir » dessinés au trait (esprit gravure botanique).
 * SVG inline en currentColor : la couleur/opacité se règlent via la classe
 * (ex. text-forest-700/15). Zéro requête réseau, zéro poids image.
 *
 * Motifs : ble, tomate, carotte, radis, abeille, raisin, brin, fleur.
 * Usage :
 *   <Botanical name="ble" class="absolute -top-4 right-8 h-32 w-32 text-cream-100/20 rotate-12" />
 */
interface Props {
  name: "ble" | "tomate" | "carotte" | "radis" | "abeille" | "raisin" | "brin" | "fleur";
  class?: string;
  /** Épaisseur du trait (unités viewBox 100) */
  strokeWidth?: number;
}

const { name, class: className = "", strokeWidth = 1.6 } = Astro.props;

const motifs: Record<Props["name"], string> = {
