---

<svg
  viewBox="0 0 100 100"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={`pointer-events-none select-none ${className}`}
  set:html={motifs[name]}
/>
