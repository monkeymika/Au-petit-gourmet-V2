---
import { Image } from "astro:assets";
import { restaurant, navigation } from "@data/restaurant";
import logoNegatif from "@/assets/logo/LogoNegatif_AuPetitGourmet.png";

const year = new Date().getFullYear();
---

<footer class="mt-32 rounded-t-[2.5rem] bg-forest-800 text-cream-100 md:rounded-t-[4rem]">
  <div class="container-content py-20">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <Image
          src={logoNegatif}
          alt={`${restaurant.name} — logo`}
          width={220}
          height={220}
          quality={85}
          loading="lazy"
          class="h-24 w-auto md:h-28"
        />
        <p class="mt-6 max-w-prose text-cream-100/70">
          {restaurant.tagline}. Un restaurant de village à deux pas de Nancy, où le terroir
          lorrain se met à table.
        </p>
        <a
          href={`tel:${restaurant.phone}`}
          class="mt-8 inline-flex items-center gap-2 text-sm font-medium tracking-wide text-terracotta-500 transition-colors hover:text-cream-50 link-underline"
        >
          {restaurant.phoneDisplay}
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="md:col-span-3">
        <p class="eyebrow text-terracotta-500">Adresse</p>
        <address class="mt-4 not-italic text-cream-100/85">
          {restaurant.address.street}<br />
          {restaurant.address.postalCode} {restaurant.address.city}
        </address>
      </div>

      <div class="md:col-span-2">
        <p class="eyebrow text-terracotta-500">Naviguer</p>
        <ul class="mt-4 space-y-2">
          {
            navigation.map((item) => (
              <li>
                <a href={item.href} class="text-cream-100/85 transition-colors hover:text-cream-50">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="md:col-span-2">
        <p class="eyebrow text-terracotta-500">Suivez-nous</p>
        <div class="mt-4 flex items-center gap-3">
          <a
            href={restaurant.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Au Petit Gourmet sur Instagram"
            class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-cream-100/20 text-cream-100/85 transition-all hover:border-cream-50 hover:bg-cream-50 hover:text-forest-800"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" stroke="none" />
            </svg>
          </a>
          <a
            href={restaurant.social.facebook}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Au Petit Gourmet sur Facebook"
            class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-cream-100/20 text-cream-100/85 transition-all hover:border-cream-50 hover:bg-cream-50 hover:text-forest-800"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M13.5 21v-7.5h2.55l.39-3h-2.94V8.55c0-.87.24-1.46 1.49-1.46H16.6V4.4a21.4 21.4 0 0 0-2.32-.12c-2.3 0-3.88 1.4-3.88 3.98v2.23H7.85v3h2.55V21h3.1z" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-4 border-t border-cream-100/10 pt-8 text-sm text-cream-100/60 md:flex-row md:items-center md:justify-between">
      <p>© {year} {restaurant.name}. Tous droits réservés.</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        <li>
          <a href="/mentions-legales/" class="transition-colors hover:text-cream-50">
            Mentions légales
          </a>
        </li>
        <li>
          <a href="/politique-de-confidentialite/" class="transition-colors hover:text-cream-50">
            Confidentialité
          </a>
        </li>
        <li>
          <a href="/politique-de-cookies-ue/" class="transition-colors hover:text-cream-50">
            Cookies
          </a>
        </li>
      </ul>
    </div>
  </div>
</footer>
