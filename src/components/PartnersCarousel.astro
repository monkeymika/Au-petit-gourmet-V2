---
import { Image } from "astro:assets";
import { partners } from "@data/partners";

interface Props {
  /** Durée d'un cycle complet de défilement (sec). Plus c'est grand, plus c'est lent. */
  duration?: number;
  /** Couleur des voiles de fondu sur les bords (doit matcher le fond de la section parente) */
  fadeColor?: string;
}

const { duration = 45, fadeColor = "#FBF8F3" } = Astro.props;

// On dédouble la liste pour un défilement infini sans saut (translateX 0 → -50%).
const loop = [...partners, ...partners];
---

<section
  class="partners-marquee group/marquee relative w-full overflow-hidden"
  aria-label="Nos producteurs partenaires"
  style={`--marquee-duration: ${duration}s; --marquee-fade: ${fadeColor};`}
>
  <!-- Voiles de fondu sur les bords pour atténuer l'entrée/sortie -->
  <div class="marquee-fade-left pointer-events-none absolute inset-y-0 left-0 z-10 w-16 md:w-32" aria-hidden="true"></div>
  <div class="marquee-fade-right pointer-events-none absolute inset-y-0 right-0 z-10 w-16 md:w-32" aria-hidden="true"></div>

  <ul class="marquee-track flex w-max items-center gap-12 py-8 md:gap-20 md:py-12">
    {
      loop.map((partner, i) => (
        <li
          class="flex w-[180px] shrink-0 flex-col items-center justify-center gap-3 md:w-[220px]"
          aria-hidden={i >= partners.length ? "true" : undefined}
        >
          <div class="flex h-24 w-full items-center justify-center md:h-28">
            <Image
              src={partner.logo}
              alt={`Logo ${partner.name}`}
              widths={[180, 320]}
              sizes="220px"
              loading="lazy"
              class="partner-logo max-h-full max-w-full object-contain"
            />
          </div>
          <div class="text-center">
            <p class="font-serif text-sm text-forest-900 md:text-base">{partner.name}</p>
            <p class="mt-0.5 text-[10px] uppercase tracking-[0.16em] text-ink-500 md:text-[11px]">
              {partner.role}
            </p>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .marquee-fade-left {
    background: linear-gradient(to right, var(--marquee-fade) 0%, transparent 100%);
  }
  .marquee-fade-right {
    background: linear-gradient(to left, var(--marquee-fade) 0%, transparent 100%);
  }

  .marquee-track {
    animation: marquee-scroll var(--marquee-duration, 45s) linear infinite;
    will-change: transform;
  }

  .partners-marquee:hover .marquee-track,
  .partners-marquee:focus-within .marquee-track {
    animation-play-state: paused;
  }

  .partner-logo {
    transition: transform 500ms ease;
  }

  li:hover .partner-logo {
    transform: scale(1.05);
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      /* La liste est dédoublée → -50 % = exactement la longueur d'un set complet */
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
