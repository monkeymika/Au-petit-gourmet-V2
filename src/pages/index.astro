            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
          </div>
          <p class="mt-8 text-xs font-medium uppercase tracking-[0.18em] text-ink-500">
            Téléphone
          </p>
          <p class="mt-3 font-serif text-2xl text-forest-900 md:text-3xl">
            {restaurant.phoneDisplay}
          </p>
          <span class="mt-auto pt-6 text-xs font-medium uppercase tracking-[0.15em] text-terracotta-500 opacity-0 transition-opacity group-hover:opacity-100">
            Appeler →
          </span>
        </a>

        <div class="group relative flex flex-col rounded-3xl border border-ink-900/8 bg-cream-100/50 p-8 transition-colors hover:bg-cream-100 md:p-10">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-forest-700 text-cream-50">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
          </div>
          <p class="mt-8 text-xs font-medium uppercase tracking-[0.18em] text-ink-500">
            Adresse
          </p>
          <address class="mt-3 not-italic font-serif text-2xl leading-snug text-forest-900 md:text-3xl">
            {restaurant.address.street}<br />
            <span class="text-xl md:text-2xl">{restaurant.address.postalCode} {restaurant.address.city}</span>
          </address>
          <a
            href={mapsDirections}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-auto inline-flex items-center gap-1.5 pt-6 text-xs font-medium uppercase tracking-[0.15em] text-terracotta-500 link-underline"
          >
            Voir l'itinéraire
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 17L17 7M9 7h8v8" />
            </svg>
          </a>
        </div>

        <div class="relative flex flex-col rounded-3xl border border-ink-900/8 bg-cream-100/50 p-8 md:p-10">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-forest-700 text-cream-50">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10" />
              <path d="M12 6v6l4 2" />
            </svg>
          </div>
          <p class="mt-8 text-xs font-medium uppercase tracking-[0.18em] text-ink-500">
            Horaires d'ouverture
          </p>
          <ul class="mt-4 divide-y divide-ink-900/8 text-sm">
            <li class="flex items-center justify-between gap-3 py-1.5">
              <span class="font-medium text-forest-900">Lun · Mar · Jeu</span>
              <span class="text-ink-600">12h — 13h30</span>
            </li>
            <li class="flex items-center justify-between gap-3 py-1.5">
              <span class="font-medium text-forest-900">Vendredi</span>
              <span class="text-right text-ink-600">12h — 13h30<br />19h — 21h</span>
            </li>
            <li class="flex items-center justify-between gap-3 py-1.5">
              <span class="font-medium text-forest-900">Samedi</span>
              <span class="text-ink-600">19h — 21h</span>
            </li>
            <li class="flex items-center justify-between gap-3 py-1.5">
              <span class="font-medium text-forest-900">Dimanche</span>
              <span class="text-ink-600">12h — 13h30</span>
            </li>
            <li class="flex items-center justify-between gap-3 py-1.5">
              <span class="italic text-ink-500">Mercredi</span>
              <span class="italic text-ink-500">Fermé</span>
            </li>
          </ul>
        </div>
      </div>

      <div class="mt-5 overflow-hidden rounded-3xl border border-ink-900/8 shadow-xl shadow-ink-900/10 md:mt-6">
        <iframe
          src={mapsEmbed}
          width="100%"
          height="500"
          style="border:0;"
          loading="lazy"
          allowfullscreen
          referrerpolicy="no-referrer-when-downgrade"
          title="Carte — Au Petit Gourmet, Ville-en-Vermois"
          class="block h-[360px] w-full md:h-[480px]"
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
