---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import logoIcon from "@/assets/logo/LogoReduit_AuPetitGourmet.png";

interface Props {
  /** Image de fond. Si fournie, remplace la vidéo. */
  imageSrc?: ImageMetadata;
  /** Texte alternatif pour l'image de fond. */
  imageAlt?: string;
}

const { imageSrc, imageAlt = "" } = Astro.props;
---

<section
  id="hero"
  class="relative h-[220vh] bg-cream-50 md:h-[260vh]"
  data-hero-section
>
  <div class="sticky top-0 h-screen w-full" data-hero-stage>
    <div
      class="absolute inset-x-0 top-0 h-full overflow-hidden"
      data-hero-video-area
      style="clip-path:inset(0 0 0% 0 round 0 0 0px 0px);will-change:clip-path;"
    >
      <div class="absolute inset-0 overflow-hidden" data-hero-video-wrap style="will-change:transform;">
        {imageSrc ? (
          <Image
            src={imageSrc}
            alt={imageAlt}
            widths={[1280, 1600, 1920]}
            sizes="100vw"
            class="h-full w-full object-cover"
            loading="eager"
            fetchpriority="high"
          />
        ) : (
          <video
            class="h-full w-full object-cover"
            autoplay
            muted
            loop
            playsinline
            preload="auto"
            poster="/videos/hero-poster.webp"
            aria-hidden="true"
          >
            <!-- Mobile : version 960×540 (1,9 Mo vs 4,8) — `media` sur <source>
                 est supporté par Safari 15+/Chrome 106+ ; les anciens
                 navigateurs ignorent l'attribut et prennent la 1re source. -->
            <source src="/videos/hero-mobile.mp4" type="video/mp4" media="(max-width: 767px)" />
            <source src="/videos/hero.mp4" type="video/mp4" />
          </video>
        )}
      </div>

      <div class="absolute inset-0 bg-gradient-to-b from-forest-900/55 via-forest-900/25 to-forest-900/80"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-forest-900/55 via-transparent to-transparent"></div>
      <!-- Renfort mobile/tablette : vignette bas plus sombre pour la lisibilité du texte -->
      <div class="absolute inset-0 bg-gradient-to-t from-forest-900/85 via-forest-900/45 to-forest-900/15 lg:hidden"></div>

      <div class="relative flex h-full flex-col">
        <div
          class="absolute top-6 left-1/2 -ml-12 z-10 flex h-[44px] items-center md:top-10 md:-ml-16 lg:left-10 lg:ml-0"
          data-hero-logo
        >
          <Image
            src={logoIcon}
            alt="Au Petit Gourmet"
            width={256}
            height={256}
            loading="eager"
            class="h-24 w-24 object-contain drop-shadow-xl md:h-32 md:w-32"
          />
        </div>

        <div
          class="container-content flex flex-1 flex-col items-center justify-center text-center md:items-start md:text-left lg:justify-end lg:pb-40"
          data-hero-content
        >
          <p class="text-xs font-medium uppercase tracking-[0.22em] text-cream-50/80">
            <slot name="eyebrow">Restaurant · Ville-en-Vermois · Lorraine</slot>
          </p>
          <h1 class="mt-6 font-serif text-display leading-[0.95] text-cream-50">
            <slot name="title">
              Au Petit Gourmet,<br />
              cuisine <em class="text-terracotta-500">locale</em><br />
              et <em class="text-terracotta-500">de saison.</em>
            </slot>
          </h1>
          <div class="mt-6 max-w-xl space-y-3 text-cream-100/85 md:mt-8">
            <slot name="description" />
          </div>
        </div>

        <div
          class="pointer-events-none absolute inset-x-0 bottom-36 flex justify-center text-cream-50/85 lg:bottom-10"
          data-hero-scroll
        >
          <div class="relative h-20 w-20 sm:h-24 sm:w-24 md:h-32 md:w-32">
            <svg
              class="h-full w-full"
              viewBox="0 0 100 100"
              style="animation: heroScrollSpin 18s linear infinite;"
              aria-hidden="true"
            >
              <defs>
                <path id="heroScrollCircle" d="M 50, 50 m -38, 0 a 38,38 0 1,1 76,0 a 38,38 0 1,1 -76,0" />
              </defs>
              <text
                fill="currentColor"
                font-size="8.5"
                letter-spacing="3"
                font-weight="500"
                style="font-family: 'Lato', sans-serif;"
              >
                <textPath href="#heroScrollCircle" startOffset="0">
                  DÉCOUVRIR ·  DÉCOUVRIR ·  DÉCOUVRIR ·
                </textPath>
              </text>
            </svg>
            <div class="absolute inset-0 flex items-center justify-center text-cream-50">
              <svg
                width="18"
                height="18"
                viewBox="0 0 18 18"
                fill="none"
                stroke="currentColor"
                stroke-width="1"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <line x1="9" y1="3" x2="9" y2="14" />
                <polyline points="4,9 9,14 14,9" />
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>

    <a
      href="/la-carte/"
      class="group absolute left-1/2 z-20 inline-flex w-[90%] max-w-xl items-center gap-4 rounded-full bg-cream-50/85 py-3 pl-7 pr-3 text-forest-900 shadow-2xl shadow-forest-900/20 backdrop-blur-2xl transition-colors hover:bg-cream-50 md:w-auto md:gap-6 md:py-4 md:pl-10 md:pr-3"
      data-hero-cta
      style="top:100%;transform:translate(-50%,-50%);"
    >
      <span class="flex-1 text-left font-serif text-base leading-snug md:text-xl">
        Notre cuisine évolue avec les saisons.<br />
        <span class="text-forest-700/70">Découvrez la carte du moment.</span>
      </span>
      <span
        class="inline-flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-forest-700 text-cream-50 transition-transform group-hover:rotate-45 md:h-16 md:w-16"
        aria-hidden="true"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 17L17 7M9 7h8v8" />
        </svg>
      </span>
      <span class="sr-only">Voir la carte</span>
    </a>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>("[data-hero-section]");
  const videoArea = document.querySelector<HTMLElement>("[data-hero-video-area]");
  const content = document.querySelector<HTMLElement>("[data-hero-content]");
  const logo = document.querySelector<HTMLElement>("[data-hero-logo]");
  const scrollHint = document.querySelector<HTMLElement>("[data-hero-scroll]");
  const videoWrap = document.querySelector<HTMLElement>("[data-hero-video-wrap]");
  const cta = document.querySelector<HTMLElement>("[data-hero-cta]");
  const pillNav = document.querySelector<HTMLElement>("[data-pill-nav]");

  if (section && content && logo && videoArea) {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let ticking = false;

    const MAX_RADIUS = 64;
    const MAX_CREAM_REVEAL = 26;
    const REST_OFFSET = 48;
    const REVEAL_START = 0.5;

    const update = () => {
      const rect = section.getBoundingClientRect();
      const vh = window.innerHeight;
      const scrollableHeight = section.offsetHeight - vh;
      const progress = scrollableHeight > 0
        ? Math.max(0, Math.min(-rect.top / scrollableHeight, 1))
        : 0;

      if (reducedMotion) {
        ticking = false;
        return;
      }

      // Title: fades + rises (0 → 0.35)
      const titleP = Math.min(progress / 0.35, 1);
      content.style.opacity = String(1 - titleP);
      content.style.transform = `translate3d(0, ${-titleP * 100}px, 0)`;

      // Logo + Pill: rise from REST_OFFSET to 0 (0.35 → 0.5), just after title leaves
      const riseP = Math.max(0, Math.min((progress - 0.35) / 0.15, 1));
      const verticalOffset = REST_OFFSET * (1 - riseP);

      // Logo: rises first, then slides LEFT + fades (0.55 → 0.9)
      const logoP = Math.max(0, Math.min((progress - 0.55) / 0.35, 1));
      logo.style.opacity = String(1 - logoP);
      logo.style.transform = `translate3d(${-logoP * 320}px, ${verticalOffset}px, 0)`;

      // Pill nav: just rises, stays visible (desktop only — on mobile it's bottom-centered)
      if (pillNav && window.innerWidth >= 768) {
        pillNav.style.transform = `translate3d(0, ${verticalOffset}px, 0)`;
      }

      // Scroll hint: fades fast
      if (scrollHint) {
        scrollHint.style.opacity = String(Math.max(0, 1 - progress * 5));
      }

      // Ken Burns zoom on video
      if (videoWrap) {
        videoWrap.style.transform = `scale(${1 + progress * 0.08})`;
      }

      // Video area: starts revealing cream + rounding only after REVEAL_START
      // so the CTA pill (anchored on the boundary) stays off-screen until then.
      // clip-path (compositor-friendly) instead of height/border-radius:
      // no layout/repaint of the playing video on every scroll frame.
      const revealP = Math.max(0, Math.min((progress - REVEAL_START) / (1 - REVEAL_START), 1));
      const radius = revealP * MAX_RADIUS;
      const clipBottom = revealP * MAX_CREAM_REVEAL;
      videoArea.style.clipPath = `inset(0 0 ${clipBottom}% 0 round 0 0 ${radius}px ${radius}px)`;

      // CTA pill: anchored to the video/cream boundary, hidden below viewport
      // at rest (extra px offset so its top half doesn't peek above the screen
      // edge). Moved via transform only — `top` would trigger layout.
      if (cta) {
        const hideOffset = (1 - revealP) * 90;
        const offsetY = -(clipBottom / 100) * vh + hideOffset;
        cta.style.transform = `translate(-50%, calc(-50% + ${offsetY}px))`;
      }

      ticking = false;
    };

    const onScroll = () => {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    update();
  }
</script>

<style is:global>
  @keyframes heroScrollSpin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
