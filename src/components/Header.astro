---
import { Image } from "astro:assets";
import { navigation, restaurant } from "@data/restaurant";
import logoIcon from "@/assets/logo/LogoReduit_AuPetitGourmet.png";

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
};
---

<header class="sticky top-0 z-40 border-b border-ink-900/5 bg-cream-50/85 backdrop-blur-md">
  <div class="container-content flex h-20 items-center justify-between gap-8">
    <a href="/" class="group flex items-center gap-3" aria-label="Accueil — Au Petit Gourmet">
      <Image
        src={logoIcon}
        alt=""
        width={48}
        height={48}
        loading="eager"
        class="h-11 w-11 shrink-0 transition-transform duration-500 group-hover:-rotate-6"
      />
      <span class="font-serif text-xl leading-none text-forest-800 transition-colors group-hover:text-terracotta-500 sm:text-2xl">
        Au Petit Gourmet
      </span>
    </a>

    <nav class="hidden items-center gap-9 md:flex" aria-label="Navigation principale">
      {
        navigation.map((item) => (
          <a
            href={item.href}
            class:list={[
              "text-sm font-medium tracking-wide transition-colors link-underline",
              isActive(item.href) ? "text-terracotta-500" : "text-ink-900 hover:text-terracotta-500",
            ]}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      href={`tel:${restaurant.phone}`}
      class="hidden btn-primary md:inline-flex"
      aria-label={`Réserver par téléphone au ${restaurant.phoneDisplay}`}
    >
      Réserver
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14M13 5l7 7-7 7" />
      </svg>
    </a>

    <button
      type="button"
      id="mobile-menu-toggle"
      class="md:hidden inline-flex h-11 w-11 items-center justify-center rounded-full border border-ink-900/15"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18" />
      </svg>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="hidden border-t border-ink-900/5 md:hidden"
  >
    <nav class="container-content flex flex-col gap-1 py-4" aria-label="Navigation mobile">
      {
        navigation.map((item) => (
          <a
            href={item.href}
            class:list={[
              "rounded-lg px-4 py-3 text-base font-medium transition-colors",
              isActive(item.href)
                ? "bg-forest-700 text-cream-50"
                : "text-ink-900 hover:bg-cream-100",
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a href={`tel:${restaurant.phone}`} class="btn-primary mt-2 justify-center">
        Réserver — {restaurant.phoneDisplay}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Fermer le menu" : "Ouvrir le menu");
  });
</script>
