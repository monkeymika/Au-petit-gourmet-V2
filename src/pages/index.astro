---
import BaseLayout from "@layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import Hero from "@components/Hero.astro";
import { restaurant } from "@data/restaurant";
import { events } from "@data/events";
import logoPrincipal from "@/assets/logo/LogoPrincipal_AuPetitGourmet.png";
import photoJardin from "@/assets/AuPetitGourmet-PhotoJardin-.webp";
import mielPotsDetail from "@/assets/miel/02-pots-detail.webp";
import { menu, formatPrice } from "@data/menu";
import { reviews, reviewsStats } from "@data/reviews";
import type { ImageMetadata } from "astro";

const avatarToneClasses: Record<string, string> = {
  terracotta: "bg-terracotta-500/15 text-terracotta-600",
  forest: "bg-forest-400/25 text-forest-800",
  amber: "bg-amber-100 text-amber-700",
  ink: "bg-ink-500/15 text-ink-900",
};

const mapsQuery = encodeURIComponent(
  `${restaurant.address.street}, ${restaurant.address.postalCode} ${restaurant.address.city}`
);
const mapsEmbed = `https://www.google.com/maps?q=${mapsQuery}&output=embed`;
const mapsDirections = `https://www.google.com/maps/dir/?api=1&destination=${mapsQuery}`;

const previewLimits: Record<string, number> = {
  entrees: 2,
  plats: 2,
  fromages: 1,
  desserts: 2,
};

const galleryImports = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/galerie/*.webp",
  { eager: true }
);

const galleryImages = Object.entries(galleryImports)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([_, mod]) => mod.default);
---

<BaseLayout
  title="Au Petit Gourmet — Restaurant à Ville-en-Vermois près de Nancy"
  description="Restaurant de village près de Nancy. Cuisine locale et de saison, produits frais issus de nos producteurs lorrains. Réservation au 03 83 46 55 43."
>
  <Hero />

  <section data-paw class="container-content py-24 md:py-32">
    <div class="grid items-end gap-12 md:grid-cols-12 reveal">
      <div class="md:col-span-7">
        <p class="eyebrow">Bienvenue chez nous</p>
        <h2 class="mt-6 font-serif text-h1 text-forest-900">
          Une escapade <em class="text-terracotta-500">gourmande</em><br />près de Nancy.
        </h2>
        <p class="mt-8 max-w-prose text-lead text-ink-700">
          À quelques pas de l'agglomération Nancéienne, notre restaurant de village est l'idée
          de sortie parfaite pour les amateurs de découverte culinaire. Fiers de notre cuisine
          traditionnelle du terroir, nous sélectionnons avec soin des produits frais et locaux
          pour leur qualité et leur saveur unique. Venez savourer l'authenticité et la
          convivialité d'un repas chez nous.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a href={`tel:${restaurant.phone}`} class="btn-primary">
            Réserver — {restaurant.phoneDisplay}
          </a>
          <a href="/la-carte/" class="btn-ghost">Voir la carte</a>
        </div>
      </div>

      <aside class="md:col-span-5">
        <div class="rounded-3xl border border-ink-900/10 bg-cream-100/60 p-8 backdrop-blur-sm">
          <p class="eyebrow">Horaires</p>
          <ul class="mt-5 divide-y divide-ink-900/10">
            {
              restaurant.hours.map((h) => (
                <li class="flex items-center justify-between py-3 text-sm">
                  <span class:list={["font-medium", h.closed ? "text-ink-500" : "text-ink-900"]}>
                    {h.day}
                  </span>
                  <span class:list={[h.closed ? "italic text-ink-500" : "text-ink-700"]}>
                    {h.service}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="surface-cream-100-lg">
    <div class="container-content py-24 md:py-32">
      <div class="mb-16 flex items-center justify-center gap-5 text-terracotta-500 md:mb-20">
        <span class="h-px w-16 bg-current opacity-30 md:w-24"></span>
        <svg width="8" height="8" viewBox="0 0 8 8" fill="currentColor" aria-hidden="true" class="opacity-70">
          <rect x="2" y="2" width="4" height="4" transform="rotate(45 4 4)" />
        </svg>
        <span class="h-px w-16 bg-current opacity-30 md:w-24"></span>
      </div>
      <div class="grid items-center gap-12 md:grid-cols-12 reveal">
        <div class="md:col-span-6">
          <p class="eyebrow">Vu sur Instagram</p>
        <h2 class="mt-6 font-serif text-h1 text-forest-900">
          Ils <em class="text-terracotta-500">parlent</em> de nous.
        </h2>
        <div class="mt-8 max-w-prose space-y-5 text-lead text-ink-700">
          <p>
            Nous avons eu le plaisir de recevoir récemment deux créatrices de contenu
            issues de l'équipe <strong class="text-forest-800">Find Nancy</strong>, dans
            le cadre d'une visite au sein de l'une de nos guinguettes.
          </p>
          <p>
            À cette occasion, elles ont réalisé une vidéo mettant en lumière l'atmosphère
            unique et conviviale de notre établissement. Nous les remercions sincèrement
            pour leur passage ainsi que pour cette belle valorisation de notre lieu à
            travers leur contenu.
          </p>
          <p>Nous vous invitons à découvrir leur vidéo.</p>
        </div>
        <a
          href="https://www.instagram.com/reels/DLnHth0CeD7/"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost mt-10 inline-flex items-center gap-2"
        >
          Voir le reel sur Instagram
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17L17 7M9 7h8v8" />
          </svg>
        </a>
      </div>

      <div class="md:col-span-6 flex justify-center md:justify-end">
        <figure class="relative w-full max-w-[320px]">
          <div class="relative aspect-[9/16] overflow-hidden rounded-[2rem] bg-ink-900 shadow-2xl shadow-forest-900/25 ring-1 ring-ink-900/5">
            <video
              class="absolute inset-0 h-full w-full object-cover"
              playsinline
              preload="none"
              poster="/videos/find-nancy-poster.webp"
              aria-label="Reportage @find.nancy au restaurant Au Petit Gourmet"
              data-insta-video
              data-src="/videos/find-nancy-reel.mp4"
            ></video>
            <div class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-ink-900/70 to-transparent" data-insta-overlay></div>
            <a
              href="https://www.instagram.com/find.nancy/"
              target="_blank"
              rel="noopener noreferrer"
              class="absolute bottom-4 left-4 inline-flex items-center gap-2 rounded-full bg-cream-50/90 px-3 py-1.5 text-xs font-medium text-forest-900 backdrop-blur-md transition-colors hover:bg-cream-50"
              data-insta-badge
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" />
              </svg>
              @find.nancy
            </a>
            <button
              type="button"
              class="group absolute inset-0 z-10 flex items-center justify-center"
              data-insta-play
              aria-label="Lancer la vidéo"
            >
              <span class="inline-flex h-20 w-20 items-center justify-center rounded-full bg-cream-50/95 text-forest-900 shadow-2xl shadow-ink-900/40 backdrop-blur-md transition-transform group-hover:scale-110 md:h-24 md:w-24">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="md:h-8 md:w-8 ml-1">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </span>
            </button>
          </div>
        </figure>
      </div>

      <script>
        const instaVideo = document.querySelector<HTMLVideoElement>("[data-insta-video]");
        const playBtn = document.querySelector<HTMLButtonElement>("[data-insta-play]");
        const overlay = document.querySelector<HTMLElement>("[data-insta-overlay]");
        const badge = document.querySelector<HTMLElement>("[data-insta-badge]");

        if (instaVideo && playBtn) {
          playBtn.addEventListener("click", () => {
            const src = instaVideo.dataset.src;
            if (src && !instaVideo.src) {
              instaVideo.src = src;
            }
            instaVideo.controls = true;
            instaVideo.play().catch(() => {});
            playBtn.classList.add("hidden");
            overlay?.classList.add("hidden");
            badge?.classList.add("hidden");
          });
        }
      </script>
      </div>
    </div>
  </section>

  <section class="container-content py-24 md:py-32">
    <div class="flex flex-col items-center text-center reveal">
      <p class="eyebrow">À l'affiche</p>
      <h2 class="mt-6 font-serif text-h1 text-forest-900">
        Nos <em class="text-terracotta-500">événements.</em>
      </h2>
    </div>

    <div class="mt-16 grid gap-10 md:grid-cols-3 md:gap-8 reveal">
      {
        events.map((event) => (
          <article class="group flex flex-col">
            <button
              type="button"
              class="relative aspect-[3/4] overflow-hidden rounded-2xl bg-cream-100 ring-1 ring-ink-900/5 transition-shadow hover:shadow-xl"
              data-lightbox-trigger
              data-poster={event.poster}
              data-poster-alt={event.posterAlt}
              aria-label={`Voir l'affiche : ${event.title}`}
            >
              <img
                src={event.poster}
                alt={event.posterAlt}
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
                loading="lazy"
              />
              <span class="pointer-events-none absolute inset-x-4 bottom-4 inline-flex items-center justify-between gap-2 rounded-full bg-cream-50/90 px-4 py-2 text-xs font-medium uppercase tracking-[0.15em] text-forest-900 opacity-0 backdrop-blur-md transition-opacity group-hover:opacity-100">
                Voir l'affiche
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 17L17 7M9 7h8v8" />
                </svg>
              </span>
            </button>
            <div class="mt-6">
              <h3 class="font-serif text-2xl text-forest-900 md:text-3xl">{event.title}</h3>
              <p class="mt-2 text-xs font-medium uppercase tracking-[0.18em] text-terracotta-500">
                {event.period}
              </p>
              <p class="mt-3 text-base text-ink-700">{event.excerpt}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <div
    id="event-lightbox"
    class="fixed inset-0 z-[80] hidden items-center justify-center bg-ink-900/90 p-6 backdrop-blur-sm md:p-10"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    aria-label="Affiche en grand format"
  >
    <button
      type="button"
      id="lightbox-close"
      class="absolute right-6 top-6 inline-flex h-12 w-12 items-center justify-center rounded-full bg-cream-50/10 text-cream-50 backdrop-blur-md transition-colors hover:bg-cream-50/20 md:right-10 md:top-10"
      aria-label="Fermer"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M18 6L6 18M6 6l12 12" />
      </svg>
    </button>
    <img
      id="lightbox-image"
      src=""
      alt=""
      class="max-h-[90vh] max-w-[90vw] rounded-2xl object-contain shadow-2xl"
    />
  </div>

  <script>
    const lightbox = document.getElementById("event-lightbox");
    const lightboxImage = document.getElementById("lightbox-image") as HTMLImageElement | null;
    const lightboxClose = document.getElementById("lightbox-close");

    const openLightbox = (poster: string, alt: string) => {
      if (!lightbox || !lightboxImage) return;
      lightboxImage.src = poster;
      lightboxImage.alt = alt;
      lightbox.classList.remove("hidden");
      lightbox.classList.add("flex");
      lightbox.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    };

    const closeLightbox = () => {
      if (!lightbox) return;
      lightbox.classList.add("hidden");
      lightbox.classList.remove("flex");
      lightbox.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    };

    document.querySelectorAll<HTMLElement>("[data-lightbox-trigger]").forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const poster = trigger.dataset.poster;
        const alt = trigger.dataset.posterAlt;
        if (poster) openLightbox(poster, alt ?? "");
      });
    });

    lightboxClose?.addEventListener("click", closeLightbox);
    lightbox?.addEventListener("click", (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && lightbox && !lightbox.classList.contains("hidden")) {
        closeLightbox();
      }
    });
  </script>

  <section data-paw="dark" class="px-4 md:px-6 lg:px-8">
    <div class="overflow-hidden rounded-[2rem] bg-forest-700 text-cream-50 md:rounded-[2.5rem] lg:rounded-[3rem]">
    <div class="container-content py-24 md:py-32">
      <div class="mb-16 flex items-center justify-center gap-5 text-terracotta-500 md:mb-20">
        <span class="h-px w-16 bg-current opacity-40 md:w-24"></span>
        <svg width="8" height="8" viewBox="0 0 8 8" fill="currentColor" aria-hidden="true" class="opacity-80">
          <rect x="2" y="2" width="4" height="4" transform="rotate(45 4 4)" />
        </svg>
        <span class="h-px w-16 bg-current opacity-40 md:w-24"></span>
      </div>
      <div class="grid items-center gap-12 md:grid-cols-12 md:gap-16 reveal">
        <div class="flex justify-center md:col-span-5 md:justify-start">
          <Image
            src={logoPrincipal}
            alt=""
            width={640}
            height={640}
            quality={85}
            loading="lazy"
            class="h-72 w-72 object-contain md:h-96 md:w-96 lg:h-[28rem] lg:w-[28rem]"
          />
        </div>
        <div class="md:col-span-7">
          <p class="eyebrow text-terracotta-500">Le midi en semaine</p>
          <h2 class="mt-6 font-serif text-h1">
            Nos <em class="text-terracotta-500">formules</em>.
          </h2>
          <p class="mt-4 text-sm uppercase tracking-[0.18em] text-cream-100/70">
            {restaurant.formulesMidi.schedule}
          </p>

          <ul class="mt-10 space-y-6">
            {
              restaurant.formulesMidi.items.map((formule) => (
                <li class="border-b border-cream-100/15 pb-6 last:border-b-0 last:pb-0">
                  <div class="flex items-baseline justify-between gap-4">
                    <h3 class="font-serif text-xl text-cream-50 md:text-2xl">
                      {formule.name}
                    </h3>
                    <span class="shrink-0 font-serif text-2xl text-terracotta-500 md:text-3xl">
                      {formule.price}
                    </span>
                  </div>
                  {formule.details && (
                    <p class="mt-2 text-sm text-cream-100/70">{formule.details}</p>
                  )}
                </li>
              ))
            }
          </ul>

        </div>
      </div>
    </div>
    </div>
  </section>

  <section class="relative overflow-hidden">
    <span
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 top-16 select-none text-center font-serif italic leading-none text-forest-900/[0.045] md:top-24"
      style="font-size: clamp(8rem, 28vw, 22rem);"
    >
      Carte
    </span>

    <div class="relative container-content py-24 md:py-32">
      <div class="flex flex-col items-center text-center reveal">
        <p class="eyebrow">À la carte</p>
        <h2 class="mt-6 font-serif text-h1 text-forest-900">
          Notre <em class="text-terracotta-500">cuisine</em>, en détail.
        </h2>
        <p class="mt-6 max-w-prose text-lead text-ink-700">
          Quelques signatures de la carte — qui évolue au fil des saisons.
        </p>
      </div>

      <div class="mt-20 grid gap-x-16 gap-y-16 md:grid-cols-2 md:gap-y-20 reveal">
        {
          menu.sections.map((section) => (
            <div>
              <div class="text-center">
                <h3 class="font-serif text-base uppercase tracking-[0.3em] text-forest-900 md:text-lg">
                  {section.title}
                </h3>
                <span class="mx-auto mt-3 block h-px w-12 bg-ink-900/30" />
              </div>

              <ul class="mt-8 space-y-7">
                {section.items
                  .slice(0, previewLimits[section.slug] ?? 2)
                  .map((item) => (
                    <li>
                      <div class="flex items-baseline gap-3">
                        <h4 class="font-serif italic text-lg text-forest-900 md:text-xl">
                          {item.name}
                        </h4>
                        <span
                          aria-hidden="true"
                          class="-translate-y-1 flex-1 border-b border-dotted border-ink-900/35"
                        />
                        <span class="shrink-0 font-serif text-base text-terracotta-500 md:text-lg">
                          {item.prices.length === 1
                            ? formatPrice(item.prices[0].amount)
                            : `${formatPrice(item.prices[0].amount)} / ${formatPrice(item.prices[1].amount)}`}
                        </span>
                      </div>
                      {item.description && (
                        <p class="mt-1.5 text-sm text-ink-600">
                          {item.description}
                        </p>
                      )}
                    </li>
                  ))}
              </ul>
            </div>
          ))
        }
      </div>

      <div class="mt-20 flex justify-center">
        <a
          href="/la-carte/"
          class="inline-flex items-center gap-3 rounded-full bg-forest-700 px-8 py-4 text-sm font-medium uppercase tracking-[0.15em] text-cream-50 transition-all hover:gap-4 hover:bg-forest-800"
        >
          Voir la carte complète
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section class="surface-cream-100-lg">
    <div class="container-content py-24 md:py-32">
      <div class="mb-16 flex items-center justify-center gap-5 text-terracotta-500 md:mb-20">
        <span class="h-px w-16 bg-current opacity-30 md:w-24"></span>
        <svg width="8" height="8" viewBox="0 0 8 8" fill="currentColor" aria-hidden="true" class="opacity-70">
          <rect x="2" y="2" width="4" height="4" transform="rotate(45 4 4)" />
        </svg>
        <span class="h-px w-16 bg-current opacity-30 md:w-24"></span>
      </div>

      <div class="flex flex-col items-center text-center reveal">
        <p class="eyebrow">Galerie</p>
        <h2 class="mt-6 font-serif text-h1 text-forest-900">
          Pour vous mettre <em class="text-terracotta-500">en appétit…</em>
        </h2>
      </div>

      <div class="mt-16 columns-2 gap-4 md:columns-3 md:gap-5 lg:columns-4 reveal-soft">
        {
          galleryImages.map((img, i) => (
            <button
              type="button"
              class="group mb-4 block w-full overflow-hidden rounded-2xl bg-cream-50 ring-1 ring-ink-900/5 transition-shadow hover:shadow-xl md:mb-5"
              style="break-inside: avoid;"
              data-home-gallery-trigger
              data-index={i}
              aria-label={`Voir la photo ${i + 1} en grand`}
            >
              <Image
                src={img}
                alt={`Au Petit Gourmet — photo ${i + 1}`}
                widths={[300, 500, 700, 1000]}
                sizes="(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw"
                loading="lazy"
                quality={80}
                class="w-full h-auto transition-transform duration-700 group-hover:scale-[1.03]"
              />
            </button>
          ))
        }
      </div>

      <div class="mt-12 flex justify-center md:mt-16">
        <a
          href="/galerie/"
          class="inline-flex items-center gap-3 rounded-full bg-forest-700 px-8 py-4 text-sm font-medium uppercase tracking-[0.15em] text-cream-50 transition-all hover:gap-4 hover:bg-forest-800"
        >
          Voir la galerie complète
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>

    <div
      id="home-gallery-lightbox"
      class="fixed inset-0 z-[80] hidden items-center justify-center bg-ink-900/95 p-4 backdrop-blur-sm md:p-8"
      role="dialog"
      aria-modal="true"
      aria-hidden="true"
      aria-label="Photo en grand format"
    >
      <button
        type="button"
        id="home-gallery-close"
        class="absolute right-4 top-4 inline-flex h-11 w-11 items-center justify-center rounded-full bg-cream-50/10 text-cream-50 backdrop-blur-md transition-colors hover:bg-cream-50/20 md:right-8 md:top-8 md:h-12 md:w-12"
        aria-label="Fermer"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12" />
        </svg>
      </button>
      <button
        type="button"
        id="home-gallery-prev"
        class="absolute left-4 top-1/2 -translate-y-1/2 inline-flex h-11 w-11 items-center justify-center rounded-full bg-cream-50/10 text-cream-50 backdrop-blur-md transition-colors hover:bg-cream-50/20 md:left-8 md:h-12 md:w-12"
        aria-label="Photo précédente"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 18l-6-6 6-6" />
        </svg>
      </button>
      <button
        type="button"
        id="home-gallery-next"
        class="absolute right-4 top-1/2 -translate-y-1/2 inline-flex h-11 w-11 items-center justify-center rounded-full bg-cream-50/10 text-cream-50 backdrop-blur-md transition-colors hover:bg-cream-50/20 md:right-8 md:h-12 md:w-12"
        aria-label="Photo suivante"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 18l6-6-6-6" />
        </svg>
      </button>
      <figure class="flex max-h-[90vh] max-w-[90vw] flex-col items-center justify-center gap-3">
        <img id="home-gallery-image" src="" alt="" class="max-h-[85vh] max-w-full rounded-2xl object-contain shadow-2xl" />
        <figcaption id="home-gallery-counter" class="text-xs font-medium uppercase tracking-[0.2em] text-cream-50/70"></figcaption>
      </figure>
    </div>

    <script>
      const homeTriggers = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-home-gallery-trigger]")
      );
      const homeLightbox = document.getElementById("home-gallery-lightbox");
      const homeImage = document.getElementById("home-gallery-image") as HTMLImageElement | null;
      const homeCounter = document.getElementById("home-gallery-counter");
      const homeCloseBtn = document.getElementById("home-gallery-close");
      const homePrevBtn = document.getElementById("home-gallery-prev");
      const homeNextBtn = document.getElementById("home-gallery-next");

      let homeIndex = 0;
      const homeTotal = homeTriggers.length;

      const homeShow = (index: number) => {
        if (!homeImage || !homeCounter || homeTotal === 0) return;
        homeIndex = ((index % homeTotal) + homeTotal) % homeTotal;
        const sourceImg = homeTriggers[homeIndex].querySelector("img");
        if (!sourceImg) return;
        homeImage.src = sourceImg.currentSrc || sourceImg.src;
        homeImage.alt = sourceImg.alt;
        homeCounter.textContent = `${homeIndex + 1} / ${homeTotal}`;
      };

      const homeOpen = (index: number) => {
        if (!homeLightbox) return;
        homeShow(index);
        homeLightbox.classList.remove("hidden");
        homeLightbox.classList.add("flex");
        homeLightbox.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
      };

      const homeClose = () => {
        if (!homeLightbox) return;
        homeLightbox.classList.add("hidden");
        homeLightbox.classList.remove("flex");
        homeLightbox.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
      };

      homeTriggers.forEach((trigger) => {
        trigger.addEventListener("click", () => {
          homeOpen(parseInt(trigger.dataset.index || "0", 10));
        });
      });

      homeCloseBtn?.addEventListener("click", homeClose);
      homePrevBtn?.addEventListener("click", () => homeShow(homeIndex - 1));
      homeNextBtn?.addEventListener("click", () => homeShow(homeIndex + 1));
      homeLightbox?.addEventListener("click", (e) => {
        if (e.target === homeLightbox) homeClose();
      });
      document.addEventListener("keydown", (e) => {
        if (homeLightbox?.classList.contains("hidden")) return;
        if (e.key === "Escape") homeClose();
        else if (e.key === "ArrowLeft") homeShow(homeIndex - 1);
        else if (e.key === "ArrowRight") homeShow(homeIndex + 1);
      });
    </script>
