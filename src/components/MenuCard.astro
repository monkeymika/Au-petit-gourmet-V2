---
/**
 * Encadré d'un menu fixe (onglets « Menus & Formules » / menu de fête de /la-carte/).
 * Si `menu.festive` est vrai : habillage festif (confettis, serpentins, tampon prix doré).
 */
import type { FixedMenu } from "@data/menus";
import { formatWinePrice } from "@data/vins";

interface Props {
  menu: FixedMenu;
}

const { menu: m } = Astro.props;
---

<article
  id={m.slug}
  class:list={[
    "relative scroll-mt-40 overflow-hidden rounded-3xl border p-8 md:p-12",
    m.festive ? "festive-card border-[#C9A24A]/50 bg-cream-50" : "border-ink-900/10 bg-cream-100/40",
  ]}
>
  {m.festive && (
    <div class="festive-confetti pointer-events-none absolute inset-0" aria-hidden="true">
      {/* Serpentins dorés (esprit traits de pinceau de l'affiche) */}
      <svg class="festive-swirl absolute -left-6 -top-4 w-56 md:w-80" viewBox="0 0 300 160" fill="none">
        <path d="M4 120 C 60 20, 140 10, 170 60 S 120 140, 90 100 S 180 10, 296 30" stroke="url(#gold-a)" stroke-width="2.2" stroke-linecap="round" />
        <path d="M20 150 C 80 80, 150 70, 210 110" stroke="url(#gold-a)" stroke-width="1.2" stroke-linecap="round" opacity=".6" />
        <defs>
          <linearGradient id="gold-a" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#C9A24A" stop-opacity="0" />
            <stop offset=".3" stop-color="#D9B866" />
            <stop offset="1" stop-color="#A8822F" stop-opacity=".2" />
          </linearGradient>
        </defs>
      </svg>
      <svg class="festive-swirl absolute -bottom-16 -right-16 w-56 rotate-180 md:-bottom-14 md:w-72" viewBox="0 0 300 160" fill="none">
        <path d="M4 120 C 60 20, 140 10, 170 60 S 120 140, 90 100 S 180 10, 296 30" stroke="url(#gold-a)" stroke-width="2.2" stroke-linecap="round" />
      </svg>

      {/* Confettis : [position, taille px, délai s, visible mobile] */}
      {([
        ["top:7%;right:6%", 26, 0, true],
        ["top:15%;right:13%", 12, 1.2, false],
        ["top:4%;right:20%", 7, 0.6, false],
        ["top:26%;right:3%", 10, 2.1, true],
        ["top:38%;right:8%", 6, 1.7, false],
        ["top:5%;left:42%", 9, 0.9, false],
        ["top:48%;left:3%", 8, 2.6, false],
        ["bottom:9%;left:4%", 22, 0.3, true],
        ["bottom:18%;left:10%", 10, 1.5, false],
        ["bottom:5%;left:15%", 6, 2.3, false],
        ["bottom:30%;left:2.5%", 13, 0.8, false],
        ["bottom:7%;right:9%", 14, 1.1, false],
        ["bottom:16%;right:4%", 8, 2.8, true],
        ["bottom:3%;left:46%", 7, 1.9, false],
      ] as const).map(([pos, size, delay, mobile]) => (
        <span
          class:list={["festive-dot", !mobile && "hidden md:block"]}
          style={`${pos};width:${size}px;height:${size}px;animation-delay:-${delay}s`}
        />
      ))}
      {([
        ["top:20%;right:20%", 20, 0.4],
        ["bottom:24%;left:16%", 18, 1.6],
        ["top:52%;right:2.5%", 15, 2.4],
        ["top:60%;left:20%", 13, 1.0],
      ] as const).map(([pos, size, delay]) => (
        <span class="festive-star hidden md:block" style={`${pos};font-size:${size}px;animation-delay:-${delay}s`}>✦</span>
      ))}
    </div>
  )}
  <div class="relative grid gap-8 md:grid-cols-12 md:gap-12">
    <header class="md:col-span-4">
      {m.subtitle && <p class:list={["eyebrow", m.festive && "!text-[#A8822F]"]}>{m.festive && "✦ "}{m.subtitle}{m.festive && " ✦"}</p>}
      <h3 class="mt-3 font-serif text-3xl text-forest-900 md:text-4xl">
        {m.festive ? <span class="festive-brush">{m.title}</span> : m.title}
      </h3>
      {m.festive ? (
        <p class="festive-stamp mt-6 inline-flex items-baseline gap-1 font-serif text-cream-50">
          <span class="text-3xl md:text-4xl">{formatWinePrice(m.price)}</span>
          <span class="text-sm italic">/ pers.</span>
        </p>
      ) : (
        <p class="mt-4 font-serif text-3xl text-terracotta-500 md:text-4xl">
          {formatWinePrice(m.price)}
        </p>
      )}
      {m.schedule && (
        <p class="mt-4 text-xs font-medium uppercase tracking-[0.18em] text-ink-500">
          {m.schedule}
        </p>
      )}
    </header>
    <div class="md:col-span-8">
      <ul class="space-y-6">
        {m.courses?.map((c) => (
          <li class:list={["border-l-2 pl-5", m.festive ? "border-[#C9A24A]/60" : "border-forest-700/40"]}>
            <p class="font-serif text-lg text-forest-900">{c.label}</p>
            {c.items && c.items.length > 0 && (
              <ul class="mt-2 space-y-1.5 text-base italic text-ink-700">
                {c.items.map((line) => <li>· {line}</li>)}
              </ul>
            )}
            {c.allergens && (
              <p class="mt-2 text-[11px] font-medium uppercase tracking-[0.18em] text-ink-500">
                Allergènes&nbsp;: {c.allergens}
              </p>
            )}
          </li>
        ))}
      </ul>
    </div>
  </div>
</article>

<style>
  /* Menu festif — confettis dorés, esprit affiche cliente */
  .festive-card {
    box-shadow: 0 20px 50px -30px rgba(168, 130, 47, 0.45);
  }
  .festive-dot {
    position: absolute;
    border-radius: 9999px;
    background: radial-gradient(circle at 35% 30%, #F3DD9E, #C9A24A 55%, #8F6E25);
    box-shadow: 0 2px 6px -2px rgba(143, 110, 37, 0.5);
    opacity: 0.85;
    animation: festive-float 6s ease-in-out infinite;
  }
  .festive-star {
    position: absolute;
    line-height: 1;
    color: #C9A24A;
    animation: festive-twinkle 3.2s ease-in-out infinite;
  }
  .festive-swirl {
    opacity: 0.7;
  }
  @keyframes festive-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-7px); }
  }
  @keyframes festive-twinkle {
    0%, 100% { opacity: 0.25; transform: scale(0.8) rotate(0deg); }
    50% { opacity: 1; transform: scale(1.15) rotate(20deg); }
  }

  /* Surlignage doré façon pinceau, avec reflet qui passe */
  .festive-brush {
    background:
      linear-gradient(100deg, transparent 40%, rgba(255, 246, 214, 0.9) 50%, transparent 60%) no-repeat,
      linear-gradient(100deg, transparent 1%, rgba(201, 162, 74, 0.5) 5%, rgba(217, 184, 102, 0.38) 90%, transparent 99%) no-repeat;
    background-size: 250% 0.5em, 100% 0.5em;
    background-position: 150% 88%, 0 88%;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    animation: festive-shine 4.5s ease-in-out infinite;
  }
  @keyframes festive-shine {
    0%, 55% { background-position: 150% 88%, 0 88%; }
    100% { background-position: -50% 88%, 0 88%; }
  }

  /* Tampon prix incliné, comme sur l'affiche */
  .festive-stamp {
    position: relative;
    padding: 0.5rem 1.1rem;
    transform: rotate(-6deg);
    background: linear-gradient(135deg, #C9A24A, #A8822F 60%, #8F6E25);
    border-radius: 6px;
    box-shadow: 0 10px 24px -10px rgba(143, 110, 37, 0.7), inset 0 0 0 2px rgba(255, 246, 214, 0.35);
    outline: 2px dashed rgba(255, 246, 214, 0.55);
    outline-offset: -7px;
    transition: transform 400ms cubic-bezier(.34, 1.56, .64, 1);
  }
  .festive-card:hover .festive-stamp {
    transform: rotate(-2deg) scale(1.05);
  }

  @media (prefers-reduced-motion: reduce) {
    .festive-dot, .festive-star, .festive-brush { animation: none; }
  }
</style>
